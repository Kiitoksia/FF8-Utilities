@typeparam TValue
@code {
    [Parameter, EditorRequired]
    public IEnumerable<TValue> Options { get; set; }

    [Parameter]
    public TValue Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public Func<TValue, string> Text { get; set; }

    [Parameter]
    public string Label { get; set; }

    [Parameter]
    public string Class { get; set; }

    [Parameter]
    public string Style { get; set; }

    private bool IsSelected(TValue option) => EqualityComparer<TValue>.Default.Equals(option, Value);
}

<div class="v-seg @Class" style="@Style" role="radiogroup" aria-label="@Label">
    @foreach (TValue option in Options)
    {
        bool selected = IsSelected(option);
        <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" class="@(selected ? "on" : null)"
                @onclick="() => ValueChanged.InvokeAsync(option)">
            @(Text?.Invoke(option) ?? option?.ToString())
        </button>
    }
</div>
