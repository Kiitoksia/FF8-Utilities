@code {
    [Parameter, EditorRequired]
    public string Name { get; set; }

    [Parameter]
    public int Size { get; set; } = 22;

    [Parameter]
    public double Stroke { get; set; } = 1.8;
}

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "back":
            <path d="M15 5l-7 7 7 7"></path>
            break;
        case "chevron":
            <path d="m9 5 7 7-7 7"></path>
            break;
        case "settings":
            <path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path>
            <circle cx="16" cy="7" r="2"></circle>
            <circle cx="10" cy="17" r="2"></circle>
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18"></path>
            break;
        case "reset":
            <path d="M4 12a8 8 0 1 0 2.5-5.8M4 4v4h4"></path>
            break;
        case "search":
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
            break;
        case "play":
            <path d="M7 5v14l12-7z" fill="currentColor"></path>
            break;
        case "check":
            <path d="m5 12 5 5 9-10"></path>
            break;
        case "cards":
            <rect x="3" y="6" width="11" height="15" rx="2"></rect>
            <path d="M8 3.5 18.6 5a2 2 0 0 1 1.7 2.3L18.6 18"></path>
            break;
        case "fish":
            <path d="M4 12c3-4 6.5-6 10.5-6 3 0 5 2.2 6.5 6-1.5 3.8-3.5 6-6.5 6C10.5 18 7 16 4 12Z"></path>
            <path d="M4 12 2 8.5M4 12l-2 3.5"></path>
            break;
        case "key":
            <circle cx="8" cy="15" r="4"></circle>
            <path d="M11 12 20 3M16 7l3 3"></path>
            break;
        case "party":
            <circle cx="9" cy="8" r="3.5"></circle>
            <path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"></path>
            break;
        case "up":
            <path d="M12 19V5M5 12l7-7 7 7"></path>
            break;
        case "down":
            <path d="M12 5v14M5 12l7 7 7-7"></path>
            break;
        case "left":
            <path d="M19 12H5M12 5l-7 7 7 7"></path>
            break;
        case "right":
            <path d="M5 12h14M12 5l7 7-7 7"></path>
            break;
        case "list":
            <path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"></path>
            break;
        case "remove":
            <circle cx="12" cy="12" r="9"></circle>
            <path d="m9 9 6 6M15 9l-6 6"></path>
            break;
        case "move":
            <path d="M12 3v18M3 12h18M12 3l-3 3M12 3l3 3M12 21l-3-3M12 21l3-3M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3"></path>
            break;
    }
</svg>
