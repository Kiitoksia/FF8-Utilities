@implements IAsyncDisposable
@inject V2UiService Ui
@inject SettingsService Settings
@inject IJSRuntime JS
@inject NavigationManager Navigation
@code {
    private bool _open;
    private IJSObjectReference _js;

    protected override void OnInitialized()
    {
        Ui.SettingsRequested += Show;
    }

    private void Show()
    {
        _open = true;
        InvokeAsync(StateHasChanged);
    }

    private void Close() => _open = false;

    private async Task Save() => await Settings.Save();

    private async Task SetPlatform(Platform value) { Settings.Platform = value; await Save(); }

    private async Task SetLanguage(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out UltimeciaManipLanguage language))
        {
            Settings.GameLanguage = language;
            await Save();
        }
    }

    private async Task SetRinoa(bool value) { Settings.UltimeciaIncludeRinoaParties = value; await Save(); }

    private async Task SetDelayFrames(ChangeEventArgs e)
    {
        string text = e.Value?.ToString();
        Settings.DelayFrames = int.TryParse(text, out int frames) ? frames : null;
        await Save();
    }

    private async Task SetSound(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out BeepSound sound))
        {
            Settings.BeepSound = sound;
            await Save();
        }
    }

    private async Task SetBeepCount(int value) { Settings.BeepCount = value; await Save(); }
    private async Task SetBeepInterval(int value) { Settings.BeepInterval = value; await Save(); }
    private async Task SetBeepOffset(int value) { Settings.BeepOffsetFrames = value; await Save(); }

    private async Task PreviewSound()
    {
        _js ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/v2.js");
        string fileName = Settings.BeepSound switch
        {
            BeepSound.Ping1 => "ping1.wav",
            BeepSound.Ping2 => "ping2.wav",
            BeepSound.Click => "click1.wav",
            BeepSound.Clack => "clack.wav",
            _ => "click1.wav"
        };
        await _js.InvokeVoidAsync("playBeep", $"{Navigation.BaseUri}res/{fileName}", Settings.BeepCount, Settings.BeepInterval, 0);
    }

    public async ValueTask DisposeAsync()
    {
        Ui.SettingsRequested -= Show;
        if (_js != null)
        {
            try { await _js.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}

<V2Dialog Open="_open" OnClose="Close" Title="Settings">
    <section>
        <div class="v-label" style="padding: 0 4px 8px">Game</div>
        <div class="v-card">
            <div class="v-row" style="border-top: 0">
                <span>Platform</span>
                <V2Segmented TValue="Platform" Options="Enum.GetValues<Platform>()" Value="Settings.Platform" ValueChanged="SetPlatform" Label="Platform" Style="min-width: 160px" />
            </div>
            <div class="v-row">
                <label for="v2-lang">Game language</label>
                <select id="v2-lang" class="v-input" value="@Settings.GameLanguage" @onchange="SetLanguage">
                    @foreach (UltimeciaManipLanguage language in Enum.GetValues<UltimeciaManipLanguage>())
                    {
                        <option value="@language">@language</option>
                    }
                </select>
            </div>
            <V2Switch Label="Ultimecia: include Rinoa parties" Value="Settings.UltimeciaIncludeRinoaParties" ValueChanged="SetRinoa" />
        </div>
    </section>

    <section>
        <div class="v-label" style="padding: 0 4px 8px">Card timer</div>
        <div class="v-card">
            <div class="v-row" style="border-top: 0">
                <div>
                    <label for="v2-delay">Custom delay frames</label>
                    <div class="muted" style="font-size: 13px">Leave blank to use the default</div>
                </div>
                <input id="v2-delay" type="number" class="v-input mono" style="width: 110px; text-align: right" placeholder="Default"
                       value="@Settings.DelayFrames" @onchange="SetDelayFrames" />
            </div>
        </div>
    </section>

    <section>
        <div class="v-label" style="padding: 0 4px 8px">Beeps</div>
        <div class="v-card">
            <div class="v-row" style="border-top: 0">
                <label for="v2-sound">Sound</label>
                <div style="display: flex; gap: 6px; align-items: center">
                    <select id="v2-sound" class="v-input" value="@Settings.BeepSound" @onchange="SetSound">
                        @foreach (BeepSound sound in Enum.GetValues<BeepSound>())
                        {
                            <option value="@sound">@sound.GetDescription()</option>
                        }
                    </select>
                    <button type="button" class="v-ib" style="background: #1A2230; border: 1px solid #2A3544" aria-label="Preview sound" @onclick="PreviewSound"><V2Icon Name="play" Size="18" /></button>
                </div>
            </div>
            <div class="v-row"><span>Number of beeps</span><V2Stepper Value="Settings.BeepCount" ValueChanged="SetBeepCount" Min="2" Max="8" Label="number of beeps" /></div>
            <div class="v-row"><span>Interval <span class="muted">(ms)</span></span><V2Stepper Value="Settings.BeepInterval" ValueChanged="SetBeepInterval" Min="50" Step="25" Label="beep interval" /></div>
            <div class="v-row"><span>Offset frames</span><V2Stepper Value="Settings.BeepOffsetFrames" ValueChanged="SetBeepOffset" Label="beep offset frames" /></div>
        </div>
    </section>

    <div class="v-foot-links">
        <span class="muted">All changes are saved automatically</span>
        <a href="">Switch to classic UI</a>
    </div>
</V2Dialog>
