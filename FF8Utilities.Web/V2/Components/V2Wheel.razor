@implements IAsyncDisposable
@inject IJSRuntime JS
@code {
    /// <summary>Nullable value 0..Max, where index 0 of the wheel is "?" (null)</summary>
    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    [Parameter]
    public int Max { get; set; } = 15;

    [Parameter]
    public string Label { get; set; }

    private ElementReference _element;
    private IJSObjectReference _js;
    private DotNetObjectReference<V2Wheel> _dotNetRef;
    private int _currentIndex = -1;

    private int Count => Max + 2;

    private static int ToIndex(int? value) => value == null ? 0 : value.Value + 1;

    private static int? ToValue(int index) => index <= 0 ? null : index - 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        int index = ToIndex(Value);
        if (firstRender)
        {
            _js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/v2.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            _currentIndex = index;
            await _js.InvokeVoidAsync("initWheel", _element, _dotNetRef, index);
        }
        else if (_js != null && index != _currentIndex)
        {
            // Value changed from outside (e.g. reset)
            _currentIndex = index;
            await _js.InvokeVoidAsync("setWheel", _element, index);
        }
    }

    [JSInvokable]
    public async Task OnWheelIndex(int index)
    {
        index = Math.Clamp(index, 0, Count - 1);
        if (index == _currentIndex) return;
        _currentIndex = index;
        await ValueChanged.InvokeAsync(ToValue(index));
        StateHasChanged();
    }

    private async Task Select(int index)
    {
        if (_js != null) await _js.InvokeVoidAsync("setWheel", _element, index);
        await OnWheelIndex(index);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp" && _currentIndex > 0) await Select(_currentIndex - 1);
        else if (e.Key == "ArrowDown" && _currentIndex < Count - 1) await Select(_currentIndex + 1);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_js != null)
            {
                await _js.InvokeVoidAsync("disposeWheel", _element);
                await _js.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        _dotNetRef?.Dispose();
    }
}

<div class="v-wheel-wrap">
    <div class="v-wheel" @ref="_element" role="listbox" tabindex="0" aria-label="@Label" @onkeydown="OnKeyDown">
        <div class="pad"></div>
        @for (int i = 0; i < Count; i++)
        {
            int index = i;
            <div class="it @(index == ToIndex(Value) ? "on" : null)" role="option" aria-selected="@(index == ToIndex(Value) ? "true" : "false")" @onclick="() => Select(index)">
                @(index == 0 ? "?" : (index - 1).ToString())
            </div>
        }
        <div class="pad"></div>
    </div>
</div>
